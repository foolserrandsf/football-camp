\" r=\"10\" fill=\"#FFFFFF\"/><text x=\"202\" y=\"233.5\" font-family=\"Arial,Helvetica,sans-serif\" font-size=\"8\" font-weight=\"700\" text-anchor=\"middle\" fill=\"#1F4D31\">RB</text><text x=\"205\" y=\"22\" font-family=\"Arial,Helvetica,sans-serif\" font-size=\"11\" font-weight=\"700\" text-anchor=\"middle\" fill=\"#F2B705\">3rd & 1: base defense, safety walks down, 8 in the box</text><text x=\"205\" y=\"252\" font-family=\"Arial,Helvetica,sans-serif\" font-size=\"11\" text-anchor=\"middle\" fill=\"rgba(255,255,255,.9)\">Offense in 12 personnel: 2 TEs to block for a run</text></svg></div><div class=\"diagram\"><svg viewBox=\"0 0 400 232\" role=\"img\" aria-label=\"Third and ten: dime defense with pass rushers charging straight at the quarterback\"><defs><marker id=\"m12w\" viewBox=\"0 0 10 10\" refX=\"8\" refY=\"5\" markerWidth=\"6\" markerHeight=\"6\" orient=\"auto-start-reverse\"><path d=\"M0 0L10 5L0 10z\" fill=\"#FFFFFF\"/></marker><marker id=\"m12y\" viewBox=\"0 0 10 10\" refX=\"8\" refY=\"5\" markerWidth=\"6\" markerHeight=\"6\" orient=\"auto-start-reverse\"><path d=\"M0 0L10 5L0 10z\" fill=\"#F2B705\"/></marker></defs><line x1=\"0\" x2=\"400\" y1=\"150\" y2=\"150\" stroke=\"#F2B705\" stroke-width=\"2\"/><text x=\"46\" y=\"145\" font-family=\"Arial,Helvetica,sans-serif\" font-size=\"10\" fill=\"rgba(255,255,255,.75)\">line of scrimmage</text><circle cx=\"163\" cy=\"134\" r=\"11\" fill=\"#F2B705\"/><text x=\"163\" y=\"137.5\" font-family=\"Arial,Helvetica,sans-serif\" font-size=\"10\" font-weight=\"700\" text-anchor=\"middle\" fill=\"#14202B\">DL</text><circle cx=\"191\" cy=\"134\" r=\"11\" fill=\"#F2B705\"/><text x=\"191\" y=\"137.5\" font-family=\"Arial,Helvetica,sans-serif\" font-size=\"10\" font-weight=\"700\" text-anchor=\"middle\" fill=\"#14202B\">DL</text><circle cx=\"219\" cy=\"134\" r=\"11\" fill=\"#F2B705\"/><text x=\"219\" y=\"137.5\" font-family=\"Arial,Helvetica,sans-serif\" font-size=\"10\" font-weight=\"700\" text-anchor=\"middle\" fill=\"#14