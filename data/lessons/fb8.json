hor=\"middle\" fill=\"#14202B\">CB</text><rect x=\"40\" y=\"104\" width=\"100\" height=\"70\" rx=\"4\" fill=\"rgba(242,183,5,.13)\" stroke=\"#F2B705\" stroke-width=\"1\" stroke-dasharray=\"3 3\"/><text x=\"90.0\" y=\"117\" font-family=\"Arial,Helvetica,sans-serif\" font-size=\"10\" font-weight=\"700\" text-anchor=\"middle\" fill=\"#F2B705\">curl/flat</text><circle cx=\"90.0\" cy=\"150\" r=\"10\" fill=\"#F2B705\"/><text x=\"90.0\" y=\"153.5\" font-family=\"Arial,Helvetica,sans-serif\" font-size=\"8\" font-weight=\"700\" text-anchor=\"middle\" fill=\"#14202B\">NB</text><rect x=\"150\" y=\"104\" width=\"100\" height=\"70\" rx=\"4\" fill=\"rgba(242,183,5,.13)\" stroke=\"#F2B705\" stroke-width=\"1\" stroke-dasharray=\"3 3\"/><text x=\"200.0\" y=\"117\" font-family=\"Arial,Helvetica,sans-serif\" font-size=\"10\" font-weight=\"700\" text-anchor=\"middle\" fill=\"#F2B705\">middle</text><circle cx=\"200.0\" cy=\"150\" r=\"10\" fill=\"#F2B705\"/><text x=\"200.0\" y=\"153.5\" font-family=\"Arial,Helvetica,sans-serif\" font-size=\"8\" font-weight=\"700\" text-anchor=\"middle\" fill=\"#14202B\">LB</text><rect x=\"260\" y=\"104\" width=\"100\" height=\"70\" rx=\"4\" fill=\"rgba(242,183,5,.13)\" stroke=\"#F2B705\" stroke-width=\"1\" stroke-dasharray=\"3 3\"/><text x=\"310.0\" y=\"117\" font-family=\"Arial,Helvetica,sans-serif\" font-size=\"10\" font-weight=\"700\" text-anchor=\"middle\" fill=\"#F2B705\">curl/flat</text><circle cx=\"310.0\" cy=\"150\" r=\"10\" fill=\"#F2B705\"/><text x=\"310.0\" y=\"153.5\" font-family=\"Arial,Helvetica,sans-serif\" font-size=\"8\" font-weight=\"700\" text-anchor=\"middle\" fill=\"#14202B\">LB</text><circle cx=\"20\" cy=\"160\" r=\"6\" fill=\"none\" stroke=\"#FFFFFF\" stroke-width=\"2\"/><text x=\"29\" y=\"164\" font-family=\"Arial,Helvetica,sans-serif\" font-size=\"10\" font-weight=\"700\" text-anchor=\"start\" fill=\"rgba(255,255,255,.9)\">soft</text><text x=\"200\" y=\"232\" font-family=\"Arial,Helvetica,sans-serif\" font-size=\"10\" text-anchor=\"middle\" fill=\"rgba(255,255,255,.9)\">Cover 4: four deep, three underneath (4 rushers not shown)</text></svg></div>\n<p><strong>Cover 4 (\"quarters\"):</strong> four defenders each take a deep quarter. Only three underneath. <em>Strong against</em> deep passes. <em>Soft spot:</em> short throws, especially to the flats near the sideline.</p>\n<p><strong>The two you'll hear on TV that aren't zones:</strong></p>\n<div class=\"diagram\"><svg viewBox=\"0 0 400 240\" role=\"img\" aria-label=\"Cover 1: man coverage on every receiver with one deep safety\"><defs><marker id=\"m23w\" viewBox=\"0 0 10 10\" refX=\"8\" refY=\"5\" markerWidth=\"6\" markerHeight=\"6\" orient=\"auto-start-reverse\"><path d=\"M0 0L10 5L0 10z\" fill=\"#FFFFFF\"/></marker><marker id=\"m23y\" viewBox=\"0 0 10 10\" refX=\"8\" refY=\"5\" markerWidth=\"6\" markerHeight=\"6\" orient=\"auto-start-reverse\"><path d=\"M0 0L10 5L0 10z\" fill=\"#F2B705\"/></marker></defs><line x1=\"0\" x2=\"400\" y1=\"190\" y2=\"190\" stroke=\"#F2B705\" stroke-width=\"2\"/><text x=\"150\" y=\"185\" font-family=\"Arial,Helvetica,sans-serif\" font-size=\"10\" fill=\"rgba(255,255,255,.75)\">line of scrimmage</text><circle cx=\"30\" cy=\"204\" r=\"9\" fill=\"#FFFFFF\"/><text x=\"30\" y=\"207.5\" font-family=\"Arial,Helvetica,sans-serif\" font-size=\"8\" font-weight=\"700\" text-anchor=\"middle\" fill=\"#1F4D31\">WR</text><circle cx=\"96\" cy=\"204\" r=\"9\" fill=\"#FFFFFF\"/><text x=\"96\" y=\"207.5\" font-family=\"Arial,Helvetica,sans-serif\" font-size=\"8\" font-weight=\"700\" text-anchor=\"middle\" fill=\"#1F4D31\">WR</text><circle cx=\"304\" cy=\"204\" r=\"9\" fill=\"#FFFFFF\"/><text x=\"304\" y=\"207.5\" font-family=\"Arial,Helvetica,sans-serif\" font-size=\"8\" font-weight=\"700\" text-anchor=\"middle\" fill=\"#1F4D31\">WR</text><circle cx=\"370\" cy=\"204\" r=\"9\" fill=\"#FFFFFF\"/><text x=\"370\" y=\"207.5\" font-family=\"Arial,Helvetica,sans-serif\" font-size=\"8\" font-weight=\"700\" text-anchor=\"middle\" fill=\"#1F